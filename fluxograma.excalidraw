      "created": 1791357697279,
      "link": null,
      "locked": false,
      "text": "Da pra avisar o colaborador\nque a situação vai ser\ntratada com seriedade e\nperguntar se ele deseja\ninformar mais alguma\ninformação extra ou apenas\nconfirmar que quer\nprosseguir",
      "fontSize": 21.800000000000054,
      "baseFontSize": 37.800000000000054,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rUdR7IyPF2FLB2fdi0eBv",
      "originalText": "Da pra avisar o colaborador que a situação vai ser tratada com seriedade e perguntar se ele deseja informar mais alguma informação extra ou apenas confirmar que quer prosseguir",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
