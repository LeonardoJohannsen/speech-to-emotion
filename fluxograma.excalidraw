      "y": 2632.3599616344827,
      "width": 582.7531127929688,
      "height": 562.9753521126759,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2pV",
      "roundness": null,
      "seed": 493213415,
      "version": 92,
      "versionNonce": 32571113,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791357377596,
      "created": 1791357234601,
      "link": null,
      "locked": false,
      "text": "Gerente Direto\nConflitos Horizontais: \"O cara da fritadeira não\nme ajuda e sobra tudo pra mim\". (O gerente tem\no poder de mudar a escala ou advertir o colega).\n\nSobrecarga e Cansaço Crônico: \"Tô dobrando\nturno direto, não tô aguentando\". (O gerente\najusta o ritmo).\n\nProblemas Estruturais/Sistemas: \"O caixa travou\ne cliente me xingou\". (O gerente precisa saber\nque o problema não foi lentidão do funcionário,\nmas da máquina).\n\nDesmotivação Padrão: \"Não sei se levo jeito pra\nisso, erro os lanches toda hora\". (O gerente entra\ncomo treinador para apoiar).",
      "fontSize": 26.492957746478865,
      "baseFontSize": 42.492957746478865,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "pKMVMSSkPgv25agVUzfwl",
      "originalText": "Gerente Direto\nConflitos Horizontais: \"O cara da fritadeira não me ajuda e sobra tudo pra mim\". (O gerente tem o poder de mudar a escala ou advertir o colega).\n\nSobrecarga e Cansaço Crônico: \"Tô dobrando turno direto, não tô aguentando\". (O gerente ajusta o ritmo).\n\nProblemas Estruturais/Sistemas: \"O caixa travou e cliente me xingou\". (O gerente precisa saber que o problema não foi lentidão do funcionário, mas da máquina).\n\nDesmotivação Padrão: \"Não sei se levo jeito pra isso, erro os lanches toda hora\". (O gerente entra como treinador para apoiar).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "_aa6KJ-D3xpZEUtSRhUCo",
      "type": "stickynote",
      "x": 1848.4083292406572,
      "y": 2800.337488916784,
      "width": 549.1978971918834,
      "height": 549.1978971918834,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffdf6b",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
