    },
    {
      "id": "qDrKNzJfT3VoQn5uOpIys",
      "type": "text",
      "x": 1864.4083292406572,
      "y": 2868.068895746616,
      "width": 510.7781677246094,
      "height": 413.7350835322194,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2rG",
      "roundness": null,
      "seed": 432865127,
      "version": 109,
      "versionNonce": 1812756062,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791441156912,
      "created": 1791357406867,
      "link": null,
      "locked": false,
      "text": "RH e Direção\nAssédio e Humilhação: Qualquer relato de\nabuso moral (gritos, xingamentos\nconstantes), assédio sexual ou\nracismo/preconceito. O gerente direto não\ntem treinamento jurídico para lidar com isso;\na empresa precisa assumir.\n\nFuros Trabalhistas Graves: \"Não caiu meu\nvale-transporte\" ou \"fizeram eu bater o\nponto e continuar limpando a loja\". Isso gera\nprocesso trabalhista massivo, a direção\nprecisa saber na hora.",
      "fontSize": 25.460620525059657,
      "baseFontSize": 25.460620525059657,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "_aa6KJ-D3xpZEUtSRhUCo",
      "originalText": "RH e Direção\nAssédio e Humilhação: Qualquer relato de abuso moral (gritos, xingamentos constantes), assédio sexual ou racismo/preconceito. O gerente direto não tem treinamento jurídico para lidar com isso; a empresa precisa assumir.\n\nFuros Trabalhistas Graves: \"Não caiu meu vale-transporte\" ou \"fizeram eu bater o ponto e continuar limpando a loja\". Isso gera processo trabalhista massivo, a direção precisa saber na hora.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
